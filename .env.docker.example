DATABASE_URL=postgresql+psycopg://videohub_user:videohub_pass@postgres:5432/videohub_dev
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2
STORAGE_LOCAL_PATH=./storage
STORAGE_MAX_QUOTA_MB=5120
STORAGE_FILE_TTL_HOURS=24

# One Solo Worker: bounded cloud requests inside each task.
LLM_CHUNK_CONCURRENCY=2
# Keep audio uploads serial initially on 10 Mbps egress; opt in to 2 after measuring.
ASR_CHUNK_CONCURRENCY=1
VIDEO_PARSE_CACHE_TTL_SECONDS=120
VIDEO_PARSE_CONCURRENCY=2
VIDEO_PARSE_FAILURE_COOLDOWN_SECONDS=30

# Browser origins for the Vue workspace; JSON array, no wildcard credentials.
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Optional Alibaba Cloud Qwen ASR (uncomment and supply a server-side key).
# ASR_PROVIDER=qwen
# ASR_API_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# ASR_API_KEY=
# ASR_MODEL=qwen3-asr-flash
# ASR_TOTAL_TIMEOUT_SECONDS=180

# 阶段 9：个人公众号登录（默认 mock，无需微信凭据）
APP_ENV=development
AUTH_REQUIRED=False
JWT_SECRET_KEY=dev-secret-change-in-production
JWT_EXPIRE_MINUTES=10080
WECHAT_MP_MODE=mock
WECHAT_MP_TOKEN=videohub_wechat_token
WECHAT_MP_APP_ID=
WECHAT_MP_APP_SECRET=
WECHAT_MP_STATIC_QR_URL=

# YouTube server egress: API and Worker must use the same values.
# Empty = direct connection. Configure a trusted server proxy for domestic hosting.
# Container loopback points to the container itself, not the host/proxy service.
YTDLP_PROXY=
# A loopback proxy must actually run in this container/network namespace.
VIDEO_EGRESS_MODE=legacy
# Optional Linux anonymous browser source, after isolated full-download acceptance.
DOUYIN_SOURCE_BACKEND=native
DOUYIN_BROWSER_EXECUTABLE_PATH=
DOUYIN_BROWSER_LIBRARY_PATH=
YOUTUBE_PROXY=
YOUTUBE_DNS_MODE=system
VIDEO_EGRESS_POLICY_VERSION=v1
SOURCE_FAILURE_THRESHOLD=3
SOURCE_FAILURE_WINDOW_SECONDS=60
SOURCE_COOLDOWN_SECONDS=300
# Install Deno >= 2.3 and enable it for production YouTube compatibility.
# EJS scripts are provided by the locked yt-dlp[default] Python dependency.
YTDLP_JS_RUNTIME=disabled
YTDLP_DENO_PATH=

# Private media uploads; originals share STORAGE_MAX_QUOTA_MB and expire after STORAGE_FILE_TTL_HOURS.
UPLOAD_IDLE_TIMEOUT_SECONDS=30
UPLOAD_TOTAL_TIMEOUT_SECONDS=600
UPLOAD_SESSION_TTL_SECONDS=3600
UPLOAD_PROBE_TIMEOUT_SECONDS=20
UPLOAD_MAX_PENDING_PER_USER=3
UPLOAD_MAX_PER_HOUR=20

# Smart clips: semantic duration by default; this is a batch resource budget, not a target clip length.
CLIPS_ENABLED=false
CLIPS_EXPORT_MAX_TOTAL_SECONDS=900
