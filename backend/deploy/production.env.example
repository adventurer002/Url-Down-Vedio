# Private server file: /etc/videohub/backend.env (root:videohub 0640)
# Replace ALL placeholders before starting. URL-encode passwords in connection URLs.
APP_ENV=production
AUTH_REQUIRED=True
ALLOWANCES_ENABLED=True
DATABASE_URL=postgresql+psycopg://REPLACE_USER:REPLACE_PASSWORD@127.0.0.1:5432/videohub_prod
REDIS_URL=redis://:REPLACE_PASSWORD@127.0.0.1:6379/0
CELERY_BROKER_URL=redis://:REPLACE_PASSWORD@127.0.0.1:6379/1
CELERY_RESULT_BACKEND=redis://:REPLACE_PASSWORD@127.0.0.1:6379/2
JWT_SECRET_KEY=REPLACE_WITH_RANDOM_SECRET
WECHAT_MP_MODE=verify_code
WECHAT_MP_TOKEN=REPLACE_WITH_RANDOM_WECHAT_TOKEN
WECHAT_MP_APP_ID=
WECHAT_MP_APP_SECRET=
WECHAT_MP_STATIC_QR_URL=
CORS_ORIGINS='["https://vedio.vip","https://www.vedio.vip"]' 
STORAGE_LOCAL_PATH=/opt/videohub/storage
STORAGE_MAX_QUOTA_MB=5120
STORAGE_MIN_FREE_MB=2048
STORAGE_FILE_TTL_HOURS=24
ASR_PROVIDER=qwen
ASR_API_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
ASR_API_KEY=REPLACE_WITH_ASR_KEY
ASR_MODEL=REPLACE_WITH_PROVIDER_CONFIRMED_MODEL_ID
ASR_TOTAL_TIMEOUT_SECONDS=180
LLM_PROVIDER=openai_compatible
LLM_API_BASE_URL=https://api.deepseek.com
LLM_API_KEY=REPLACE_WITH_LLM_KEY
LLM_MODEL=REPLACE_WITH_PROVIDER_CONFIRMED_MODEL_ID
AI_TASK_TIMEOUT_SECONDS=900
YTDLP_JS_RUNTIME=disabled
