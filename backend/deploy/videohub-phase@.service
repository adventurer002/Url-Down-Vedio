[Unit]
Description=VideoHub phase worker %i
After=network-online.target docker.service
Wants=network-online.target

[Service]
User=videohub
Group=videohub
WorkingDirectory=/opt/videohub/current/backend
EnvironmentFile=/etc/videohub/backend.env
Environment=PYTHONUNBUFFERED=1
Environment=DATABASE_POOL_SIZE=2 DATABASE_MAX_OVERFLOW=1
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
# Instance names match queue names, with optional numbered suffix (media-2).
ExecStart=/bin/sh -ec 'queue="$${1%%%%-*}"; if [ "$$queue" = control ]; then queue=control,celery; fi; exec /opt/videohub/current/backend/.venv/bin/celery -A app.infrastructure.queue.celery_app:celery_app worker --pool=solo -c 1 --queues="$$queue" --hostname="$$1@%%h" --loglevel=INFO' -- %i
Restart=on-failure
RestartSec=5
KillMode=mixed
TimeoutStopSec=3750

[Install]
WantedBy=multi-user.target
