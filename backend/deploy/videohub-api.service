[Unit]
After=network-online.target docker.service
Wants=network-online.target

[Service]
User=videohub
Group=videohub
WorkingDirectory=/opt/videohub/backend
EnvironmentFile=/etc/videohub/backend.env
Environment=PYTHONUNBUFFERED=1
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ExecStart=/opt/videohub/backend/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8000 --workers 1
Restart=on-failure
RestartSec=5
TimeoutStopSec=60

[Install]
WantedBy=multi-user.target
