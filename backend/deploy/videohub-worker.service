[Unit]
After=network-online.target docker.service
Wants=network-online.target

[Service]
User=videohub
Group=videohub
WorkingDirectory=/opt/videohub/current/backend
EnvironmentFile=/etc/videohub/backend.env
Environment=PYTHONUNBUFFERED=1
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ExecStart=/opt/videohub/current/backend/.venv/bin/celery -A app.infrastructure.queue.celery_app:celery_app worker --pool=solo -c 1 --loglevel=INFO
Restart=on-failure
RestartSec=5
# Warm stop goes only to the Worker. Its watchdog controls child process groups.
KillMode=mixed
TimeoutStopSec=1200

[Install]
WantedBy=multi-user.target
