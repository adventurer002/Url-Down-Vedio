# 将所需项加入 API 和 Worker 实际加载的服务端配置。默认关闭，显式启用后才接受新报价。
CLIPS_ENABLED=true
CLIPS_PROMPT_VERSION=clips-v1
CLIPS_SCHEMA_VERSION=clips-v1
CLIPS_ANALYSIS_TIMEOUT_SECONDS=900
CLIPS_EXPORT_TIMEOUT_SECONDS=1800
CLIPS_RENDER_TIMEOUT_SECONDS=180
CLIPS_EXPORT_MAX_TEMP_MB=1536
# 整批成片的资源保护预算，不是 AI 选片的目标时长；超限提示减少选择，不截断原句。
CLIPS_EXPORT_MAX_TOTAL_SECONDS=900
CLIPS_MAX_DAILY_EXPORTS=10
CLIPS_MAX_DAILY_PLAN_EXPORTS=3
# 单独配置一个已经确认支持 /audio/transcriptions + verbose_json + segments 时间戳的服务。
# Qwen chat/completions 的 120 秒分段不是这个定位接口，不能直接填入这里冒充句级对齐。
CLIPS_TIMING_API_BASE_URL=
CLIPS_TIMING_API_KEY=
CLIPS_TIMING_MODEL=
CLIPS_TIMING_TIMEOUT_SECONDS=180
CLIPS_TIMING_MAX_AUDIO_SECONDS=900
