# 在 backend/ 使用这些环境变量，或合并到现有服务端环境；不覆盖任何凭据。
# 根 .env.example / .env.docker.example 的数据库、Redis 配置保持原有双环境约定。
ALLOWANCES_ENABLED=true
AUTH_REQUIRED=true

# 当前选定模型；API Key 从已有安全配置注入，不把密钥写入本模板。
LLM_PROVIDER=openai_compatible
LLM_API_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-flash
ASR_PROVIDER=qwen
ASR_API_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
ASR_MODEL=qwen-audio-3.0-asr-flash

STORAGE_MAX_QUOTA_MB=5120
STORAGE_FILE_TTL_HOURS=24
