APP_ENV=dev
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/downvedio
REDIS_URL=redis://localhost:6379/0
JWT_SECRET=change-me-dev-only
SENTRY_DSN=

# Phase3: media pipeline
STORAGE_BACKEND=local
STORAGE_DIR=/tmp/downvedio-media
WORKER_TMP_DIR=/tmp/downvedio-tmp
OSS_ENDPOINT=
OSS_BUCKET=
OSS_ACCESS_KEY=
OSS_SECRET_KEY=
FILE_TTL_HOURS_FREE=24
FILE_TTL_HOURS_MEMBER=168
DOWNLOAD_TIME_LIMIT_SECONDS=1800
DOWNLOAD_MAX_RETRIES=2

LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=deepseek-flash
DEEPSEEK_BASE_URL=
DEEPSEEK_API_KEY=
WHISPER_MODEL=small

# Phase8: payments (enable per provider; PEM keys use \n for newlines)
STRIPE_ENABLED=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_SUCCESS_URL=http://localhost:5199/pay/success
STRIPE_CANCEL_URL=http://localhost:5199/pay/cancel
WECHAT_ENABLED=false
WECHAT_MCHID=
WECHAT_APPID=
WECHAT_SERIAL_NO=
WECHAT_PRIVATE_KEY=
WECHAT_APIV3_KEY=
WECHAT_NOTIFY_URL=
ALIPAY_ENABLED=false
ALIPAY_APP_ID=
ALIPAY_PRIVATE_KEY=
ALIPAY_PUBLIC_KEY=
ALIPAY_NOTIFY_URL=
ALIPAY_RETURN_URL=http://localhost:5199/pay/success
