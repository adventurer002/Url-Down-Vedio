DATABASE_URL=postgresql+psycopg://videohub_user:videohub_pass@localhost:5432/videohub_dev
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
STORAGE_LOCAL_PATH=./storage
STORAGE_MAX_QUOTA_MB=5120
STORAGE_FILE_TTL_HOURS=24

# Browser origins for the Vue workspace; JSON array, no wildcard credentials.
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Optional Alibaba Cloud Qwen ASR (uncomment and supply a server-side key).
# ASR_PROVIDER=qwen
# ASR_API_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# ASR_API_KEY=
# ASR_MODEL=qwen3-asr-flash
# ASR_TOTAL_TIMEOUT_SECONDS=180

# 阶段 9：个人公众号登录（默认 mock，无需微信凭据）
APP_ENV=development
AUTH_REQUIRED=False
JWT_SECRET_KEY=dev-secret-change-in-production
JWT_EXPIRE_MINUTES=10080
WECHAT_MP_MODE=mock
WECHAT_MP_TOKEN=videohub_wechat_token
WECHAT_MP_APP_ID=
WECHAT_MP_APP_SECRET=
WECHAT_MP_STATIC_QR_URL=

# YouTube server egress: API and Worker must use the same values.
# Empty = direct connection. Configure a trusted server proxy for domestic hosting.
# Container loopback points to the container itself, not the host/proxy service.
YTDLP_PROXY=
# Install Deno >= 2.3 and enable it for production YouTube compatibility.
# EJS scripts are provided by the locked yt-dlp[default] Python dependency.
YTDLP_JS_RUNTIME=disabled
YTDLP_DENO_PATH=
